#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kos-undo —— 把 KOS 安装器改过的东西退回去（装坏了 / 后悔了就用它）
#
#   kos-undo                   回到安装前：卸掉这次新装的包、还原文件、清掉残留目录
#   kos-undo --dry-run         只打印计划，什么都不动
#   kos-undo list              列出可回滚的时间点（安装记录 + Snapper 快照）
#   kos-undo files [ID]        只还原文件，不卸包（一般用不到）
#   kos-undo snapshot <序号>   用 Snapper 整机回档（另一条路，需要 root，回档后重启）
#   kos-undo prune             清掉空备份目录（--dry-run / --check 的历史遗留）
#
# 安装器的账本在 ~/.local/state/kos-installer/backup/<时间>/manifest.txt，
# 一行一个文件：
#   "<原路径> <sha256> <备份路径>"   安装前就存在、被覆盖的文件 → 还原时拷回去
#   "created <原路径>"               安装器新建的文件            → 还原时删掉
# 只按账本处理，不会去删账本里没有的东西。
#
# 为什么不复用 maintenance/lib/ui.sh：这条命令要能在“装到一半失败、~/scripts
# 还没装”的 TTY 里直接跑，所以只依赖 bash 和 coreutils。
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kos-installer"
BACKUP_ROOT="$STATE_DIR/backup"
ASSUME_YES=0
DRY_RUN=0
SHOW_ALL=0
BRIEF=0
SILENT_TAIL=0

say() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
kos-undo —— 把 KOS 安装器的改动退回去

最常用（就这一条）：
  kos-undo                回到安装前 —— 卸掉这次安装新装的包、还原被改过的文件、
                          删掉安装器新建的文件和目录；会先列清单再问你
  kos-undo --dry-run      只打印计划，什么都不动

其它（一般用不到）：
  kos-undo list           列出可回滚的时间点
  kos-undo files <时间点>  只还原文件，不卸包
  kos-undo snapshot <序号> 用 Snapper 整机回档（另一种做法）
  kos-undo prune          清掉空备份目录

只想重来一遍、不要回滚：直接再跑一次 bash install.sh
USAGE
}

needs_root() { case "$1" in "$HOME"/*) return 1 ;; *) return 0 ;; esac; }

fmt_run() {
  local id="$1"
  if [[ "$id" =~ ^[0-9]{8}-[0-9]{6}$ ]]; then
    printf '%s-%s-%s %s:%s:%s' "${id:0:4}" "${id:4:2}" "${id:6:2}" "${id:9:2}" "${id:11:2}" "${id:13:2}"
  else
    printf '%s' "$id"
  fi
}

list_runs() {
  local -a runs=()
  shopt -s nullglob
  runs=("$BACKUP_ROOT"/*/)
  shopt -u nullglob

  if [ "${#runs[@]}" -eq 0 ]; then
    say "  （没有备份：这个用户还没跑过 install.sh）"
    return 0
  fi

  local d m total created shown=0 hidden=0
  for d in "${runs[@]}"; do
    d="${d%/}"
    m="$d/manifest.txt"
    total=0
    created=0
    if [ -f "$m" ]; then
      total=$(grep -c . "$m" 2>/dev/null || true)
      created=$(grep -c '^created ' "$m" 2>/dev/null || true)
    fi
    if [ "${total:-0}" -eq 0 ] && [ "${SHOW_ALL:-0}" -ne 1 ]; then
      hidden=$((hidden + 1))
      continue
    fi
    printf '  %-24s %s 个文件（其中 %s 个是安装器新建的）\n' \
      "$(basename "$d")" "${total:-0}" "${created:-0}"
    printf '  %-24s %s\n' "" "$(fmt_run "$(basename "$d")")"
    shown=$((shown + 1))
  done
  if [ "$shown" -eq 0 ]; then
    say "  （没有可回滚的备份）"
  fi
  if [ "$hidden" -gt 0 ]; then
    say "  （另有 $hidden 个空时间点，是 --dry-run / --check 留下的，没有东西可还原；-a 可列出）"
  fi
}

list_snapshots() {
  local cfg
  if ! have snapper; then
    say "  （没装 snapper，跳过）"
    return 0
  fi
  for cfg in root home; do
    say "  [$cfg]"
    if ! snapper -c "$cfg" list 2>/dev/null | sed 's/^/    /'; then
      warn "读不到 $cfg 的快照（可能需要 root：sudo snapper -c $cfg list）"
    fi
  done
}

cmd_list() {
  say "== 安装器备份时间点（用 kos-undo files <ID> 还原）=="
  list_runs
  say ""
  say "== Snapper 快照（用 kos-undo snapshot <序号> 回档）=="
  list_snapshots
}

resolve_run() {
  local want="${1:-}" d id
  if [ -n "$want" ]; then
    [ -d "$want" ] && { printf '%s\n' "$want"; return 0; }
    [ -d "$BACKUP_ROOT/$want" ] && { printf '%s\n' "$BACKUP_ROOT/$want"; return 0; }
    warn "没有这个时间点：$want"
    return 1
  fi
  if [ ! -d "$BACKUP_ROOT" ]; then
    warn "还没有任何备份：$BACKUP_ROOT"
    return 1
  fi
  local -a runs=()
  shopt -s nullglob
  runs=("$BACKUP_ROOT"/*/)
  shopt -u nullglob
  if [ "${#runs[@]}" -eq 0 ]; then
    warn "还没有任何备份：$BACKUP_ROOT"
    return 1
  fi
  # 默认取“最早一次安装记录”（= 这台机器的起点）；同一台机器重跑几次安装器时，
  # 回到最早那次才是“回到装之前”，回到最近一次只是“回到上一次重跑之前”。
  # 只认有内容的清单；<日期>-<时间> 形态优先于人工命名的目录。
  local best_id="" fallback="" empty_id=""
  for d in "${runs[@]}"; do
    d="${d%/}"
    id=$(basename "$d")
    if [ -s "$d/manifest.txt" ]; then
      if [[ "$id" =~ ^[0-9]{8}-[0-9]{6}$ ]]; then
        if [ -z "$best_id" ] || [[ "$id" < "$best_id" ]]; then best_id="$id"; fi
      elif [ -z "$fallback" ] || [[ "$id" < "$fallback" ]]; then
        fallback="$id"
      fi
    elif [ -f "$d/manifest.txt" ] && [ -z "$empty_id" ]; then
      empty_id="$id"
    fi
  done
  local pick="${best_id:-${fallback:-${empty_id:-}}}"
  if [ -z "$pick" ]; then
    warn "备份目录里没有可用时间点：$BACKUP_ROOT"
    return 1
  fi
  printf '%s\n' "$BACKUP_ROOT/$pick"
}

# 不带参数时的默认动作：一条命令回到最近一次安装之前（就它一个，别的都是高级用法）
# 安装期间新增了哪些包：
#   有基线（安装开始时 pacman -Qq 的清单）就做差集，精确；
#   没有基线（旧版本安装器装的）就退回解析 /var/log/pacman.log —— RUN_ID 就是安装开始的时刻。
added_packages() {
  local run_id="$1" base since
  base="$STATE_DIR/baseline/$run_id-pacman-Qq.txt"
  if [ -f "$base" ] && have pacman; then
    comm -13 <(sort "$base") <(pacman -Qq | sort)
    return 0
  fi
  have pacman || return 1
  [ -r /var/log/pacman.log ] || return 1
  since="${run_id:0:4}-${run_id:4:2}-${run_id:6:2}T${run_id:9:2}:${run_id:11:2}:${run_id:13:2}"
  awk -v since="$since" '
    /^\[[0-9][0-9][0-9][0-9]-/ { ts = substr($0, 2, 19) }
    /\[ALPM\] installed / && ts >= since {
      line = $0
      sub(/.*\[ALPM\] installed /, "", line)
      sub(/ .*/, "", line)
      print line
    }
  ' /var/log/pacman.log | sort -u
}

# 默认动作：一条命令回到安装前 —— 退包、退文件、清残留
cmd_undo() {
  local dir run_id arg d p
  local -a added=() residue=()

  for arg in "$@"; do
    case "$arg" in
      --dry-run|-n) DRY_RUN=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      -h|--help) usage; return 0 ;;
    esac
  done

  dir=$(resolve_run "") || return 1
  run_id=$(basename "$dir")

  while IFS= read -r p; do
    [ -n "$p" ] && added+=("$p")
  done < <(added_packages "$run_id" 2>/dev/null || true)

  for d in "$HOME/.cache/kos-src" "$HOME/.local/share/kos" \
           "$HOME/.config/quickshell/kos" "$HOME/.local/state/quickshell"; do
    [ -e "$d" ] && residue+=("$d")
  done

  say "回到安装前：最早一次安装记录 $run_id（$(fmt_run "$run_id")）"
  if [ "${#added[@]}" -gt 0 ]; then
    say "  1) 卸载 ${#added[@]} 个安装期间新增的软件包："
    local n=0
    for p in "${added[@]}"; do
      say "       $p"
      n=$((n + 1))
      if [ "$n" -ge 8 ]; then say "       …（共 ${#added[@]} 个）"; break; fi
    done
  else
    say "  1) 没找到包清单，跳过卸载（只还原文件）"
  fi
  say "  2) 还原安装前被覆盖的文件，删掉安装器新建的文件"
  if [ "${#residue[@]}" -gt 0 ]; then
    say "  3) 清理安装器留下的目录："
    for d in "${residue[@]}"; do say "       $d"; done
  fi
  say "  注意：会卸掉桌面本身，请在 TTY（Ctrl+Alt+F3 登录）里跑，别在桌面会话里跑。"
  say ""

  if [ "$DRY_RUN" -eq 1 ]; then
    say "[dry-run] 以上是计划。下面是要还原的文件清单："
    say ""
    cmd_files "$dir" --dry-run
    return 0
  fi

  if [ "$ASSUME_YES" -ne 1 ]; then
    printf '确认回到安装前？[y/N] '
    read -r arg
    case "$arg" in
      y|Y|yes|YES) ;;
      *) say "已取消，什么都没改"; return 1 ;;
    esac
  fi

  local failed=0
  if [ "${#added[@]}" -gt 0 ]; then
    say ""
    say "卸载软件包…"
    if ! sudo pacman -Rns --noconfirm "${added[@]}"; then
      warn "卸载没有全部成功（通常是依赖冲突），见上面的 pacman 输出"
      failed=1
    fi
  fi

  say ""
  SILENT_TAIL=1
  cmd_files "$dir" --yes || failed=1

  if [ "${#residue[@]}" -gt 0 ]; then
    say ""
    say "清理残留目录…"
    for d in "${residue[@]}"; do
      rm -rf -- "$d" || { warn "删除失败：$d"; failed=1; }
    done
  fi

  say ""
  if [ "$failed" -eq 0 ]; then
    say "已回到安装前，重启一次就是干净的起点。"
    return 0
  fi
  warn "有步骤没成功，见上面的输出；修好后再跑一次 kos-undo"
  return 1
}

cmd_files() {
  local want="" arg dir manifest line src bak
  local -a rsrc=() rbak=() rdel=()

  for arg in "$@"; do
    case "$arg" in
      --yes|-y) ASSUME_YES=1 ;;
      --dry-run|-n) DRY_RUN=1 ;;
      -h|--help) usage; return 0 ;;
      *) want="$arg" ;;
    esac
  done

  dir=$(resolve_run "$want") || return 1
  manifest="$dir/manifest.txt"
  if [ ! -f "$manifest" ]; then
    warn "找不到清单：$manifest"
    return 1
  fi

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "created "*) rdel+=("${line#created }") ;;
      *)
        read -r src _ bak <<< "$line"
        if [ -z "${bak:-}" ]; then
          warn "清单行看不懂，跳过：$line"
          continue
        fi
        rsrc+=("$src")
        rbak+=("$bak")
        ;;
    esac
  done < "$manifest"

  say "时间点：$(basename "$dir")  （$(fmt_run "$(basename "$dir")")）"
  say "将还原 ${#rsrc[@]} 个文件，删除 ${#rdel[@]} 个安装器新建的文件："
  local i shown
  shown=0
  for i in "${!rsrc[@]}"; do
    say "  还原 ${rsrc[$i]}"
    shown=$((shown + 1))
    [ "$BRIEF" -eq 1 ] && [ "$shown" -ge 5 ] && { say "  …"; break; }
  done
  shown=0
  for i in "${!rdel[@]}"; do
    say "  删除 ${rdel[$i]}"
    shown=$((shown + 1))
    [ "$BRIEF" -eq 1 ] && [ "$shown" -ge 5 ] && { say "  …"; break; }
  done
  if [ "${#rsrc[@]}" -eq 0 ] && [ "${#rdel[@]}" -eq 0 ]; then
    say "  清单是空的，没什么可还原"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    say ""
    say "[dry-run] 只打印计划，不会改动任何文件"
    return 0
  fi

  if [ "$ASSUME_YES" -ne 1 ]; then
    printf '确认执行？[y/N] '
    read -r arg
    case "$arg" in
      y|Y|yes|YES) ;;
      *) say "已取消，什么都没改"; return 1 ;;
    esac
  fi

  local failed=0
  for i in "${!rsrc[@]}"; do
    if needs_root "${rsrc[$i]}"; then
      sudo cp -a "${rbak[$i]}" "${rsrc[$i]}" || { warn "还原失败：${rsrc[$i]}"; failed=1; }
    else
      cp -a "${rbak[$i]}" "${rsrc[$i]}" || { warn "还原失败：${rsrc[$i]}"; failed=1; }
    fi
  done
  for i in "${!rdel[@]}"; do
    if needs_root "${rdel[$i]}"; then
      sudo rm -f -- "${rdel[$i]}" || { warn "删除失败：${rdel[$i]}"; failed=1; }
    else
      rm -f -- "${rdel[$i]}" || { warn "删除失败：${rdel[$i]}"; failed=1; }
    fi
  done

  say ""
  if [ "$failed" -eq 0 ]; then
    if [ "$SILENT_TAIL" -eq 0 ]; then
      say '文件已还原。'
      say '包没有动（这里只管文件）；要连包一起退，直接跑 kos-undo。'
    fi
    return 0
  fi
  warn "有项目没处理成功，见上面的错误"
  return 1
}

cmd_prune() {
  local -a doomed=()
  local d
  shopt -s nullglob
  for d in "$BACKUP_ROOT"/*/; do
    d="${d%/}"
    [ -d "$d" ] || continue
    # 只有“清单存在但为空、而且目录里没别的东西”才算 --dry-run / --check 的残留。
    # 没有 manifest.txt 的目录是人工备份（头像、kwinrc 等），一律不碰。
    [ -f "$d/manifest.txt" ] || continue
    [ -s "$d/manifest.txt" ] && continue
    if [ -n "$(find "$d" -mindepth 1 ! -name manifest.txt -print -quit)" ]; then
      continue
    fi
    doomed+=("$d")
  done
  shopt -u nullglob
  if [ "${#doomed[@]}" -eq 0 ]; then
    say "没有空备份目录，干净。"
    return 0
  fi
  say "将删除 ${#doomed[@]} 个空备份目录（只有空的 manifest.txt，没有可还原的内容）："
  local i
  for i in "${!doomed[@]}"; do say "  ${doomed[$i]}"; done
  if [ "$DRY_RUN" -eq 1 ]; then
    say ""
    say "[dry-run] 只打印，不会删任何东西"
    return 0
  fi
  if [ "$ASSUME_YES" -ne 1 ]; then
    printf '确认删除？[y/N] '
    read -r ans
    case "$ans" in
      y|Y|yes|YES) ;;
      *) say "已取消"; return 1 ;;
    esac
  fi
  for i in "${!doomed[@]}"; do
    rm -rf -- "${doomed[$i]}" || warn "删除失败：${doomed[$i]}"
  done
  say "已清理。"
}

cmd_snapshot() {
  local id="${1:-}"
  if ! have snapper; then
    warn "没装 snapper，无法用快照回档"
    return 1
  fi
  if [ -z "$id" ]; then
    say "用法：kos-undo snapshot <Snapper 序号>"
    say ""
    list_snapshots
    return 1
  fi
  say "把根子卷回档到快照 $id：这会创建一个新的当前快照并把默认子卷指向它，回档后需要重启。"
  say "（图形界面等价操作：btrfs-assistant）"
  if [ "$ASSUME_YES" -ne 1 ]; then
    printf '确认回档？[y/N] '
    read -r ans
    case "$ans" in
      y|Y|yes|YES) ;;
      *) say "已取消"; return 1 ;;
    esac
  fi
  sudo snapper -c root rollback "$id"
}

case "${1:-undo}" in
  undo|"") shift || true; cmd_undo "$@" ;;
  list|ls) shift || true; for a in "$@"; do [ "$a" = "-a" ] || [ "$a" = "--all" ] && SHOW_ALL=1; done; cmd_list ;;
  files|restore) shift || true; cmd_files "$@" ;;
  prune|clean) shift || true; for a in "$@"; do case "$a" in --yes|-y) ASSUME_YES=1 ;; --dry-run|-n) DRY_RUN=1 ;; esac; done; cmd_prune ;;
  snapshot|rollback) shift || true; cmd_snapshot "$@" ;;
  -h|--help|help) usage ;;
  -*) cmd_undo "$@" ;;
  *) usage; exit 2 ;;
esac
