#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kos-undo —— 把机器清回"装 KOS 之前"：archinstall 刚装完、能登录 TTY 的状态。
#
# 只有一件事：全清。按顺序做四步——
#   1) 卸掉安装期间新增的全部软件包（安装开始时记了 pacman -Qq 基线，做差集）
#   2) 还原被安装器覆盖过的文件（/etc/pacman.conf、/etc/default/grub、kdeglobals…）
#   3) 删掉安装器新建的文件（账本里 "created" 的那些）
#   4) 删掉安装器留下的目录和账本外的残留（KOS 源码/应用/配置、常驻脚本、
#      SDDM 与 GRUB 主题副本、安装器自己的状态目录…）
#
# 账本：~/.local/state/kos-installer/backup/<时间>/manifest.txt
#   "<原路径> <sha256> <备份路径>"  安装前就存在、被覆盖 → 还原
#   "created <原路径>"            安装器新建 → 删除
#
# 用法：
#   kos-undo            列计划 → 问一次 y/N → 执行
#   kos-undo --dry-run  只打印计划，什么都不动
#   kos-undo --yes      不确认（给脚本用）
#   kos-undo --with-repo / --keep-repo
#                       连/不连安装器仓库检出（默认：仓库是干净的 git 检出就一起删）
#
# 只依赖 bash + coreutils：装到一半失败、~/scripts 还没装好时也能跑。
# 跑之前请在 TTY（Ctrl+Alt+F3）里，它会把这个桌面自己卸掉。
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kos-installer"
BACKUP_ROOT="$STATE_DIR/backup"
DRY_RUN=0
ASSUME_YES=0
REPO_MODE=auto          # auto | yes | no
REPO_DIR=""                 # 由 detect_repo 决定（见下）
GRUB_THEME_NAME="Elegant-mojave-window-left-dark"

say()  { printf '%s\n' "$*"; }
say2() { printf '  %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
kos-undo —— 清回"装 KOS 之前"（archinstall 刚装完的状态）

  kos-undo              列计划，问一次 y/N，然后把安装器加的东西全部清掉
  kos-undo --dry-run    只打印计划，什么都不动
  kos-undo --yes        不确认
  kos-undo --with-repo  连 ~/arch-kde 这个仓库检出一起删
  kos-undo --keep-repo  保留仓库检出（默认只在它是干净 git 检出时才删）

会做的事：卸掉安装期间新增的所有软件包 → 还原被覆盖的文件 → 删掉安装器新建的文件
→ 删除安装器留下的目录（KOS 源码/应用/配置、~/scripts、缓存、SDDM/GRUB 主题副本）
→ 最后删掉安装器自己的状态目录（含账本）。

注意：这是"清空"，不是"撤销最近一次改动"。装完之后你自己又装的包、你自己改过的
配置，也会一起没。跑完重启一次就是干净的起点。
USAGE
}

# 找安装器仓库：显式变量 > 脚本自己所在的仓库 > ~/arch-kde
detect_repo() {
  local cand="${KOS_INSTALLER_REPO:-}" here
  if [ -z "$cand" ]; then
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)
    case "$here" in
      */assets/scripts/maintenance) cand="${here%/assets/scripts/maintenance}" ;;
    esac
  fi
  if [ -z "$cand" ] || [ ! -d "$cand/.git" ]; then
    cand=""
    [ -d "$HOME/arch-kde/.git" ] && cand="$HOME/arch-kde"
  fi
  printf '%s' "$cand"
}

# 路径在 $HOME 之外就需要 sudo
needs_root() { case "$1" in "$HOME"/*) return 1 ;; *) return 0 ;; esac; }

fmt_run() {
  local id="$1"
  if [[ "$id" =~ ^[0-9]{8}-[0-9]{6}$ ]]; then
    printf '%s-%s-%s %s:%s:%s' "${id:0:4}" "${id:4:2}" "${id:6:2}" "${id:9:2}" "${id:11:2}" "${id:13:2}"
  else
    printf '%s' "$id"
  fi
}

# 取最早一份有内容的账本（= 这台机器第一次装 KOS 的那次）
resolve_run() {
  local d id best=""
  [ -d "$BACKUP_ROOT" ] || return 1
  for d in "$BACKUP_ROOT"/*/; do
    [ -d "$d" ] || continue
    id=$(basename "$d")
    [ -s "$d/manifest.txt" ] || continue
    [[ "$id" =~ ^[0-9]{8}-[0-9]{6}$ ]] || continue
    if [ -z "$best" ] || [[ "$id" < "$best" ]]; then best="$id"; fi
  done
  [ -n "$best" ] || return 1
  printf '%s\n' "$BACKUP_ROOT/$best"
}

# 安装期间新增的包：有基线就做差集，没有就退回解析 pacman.log
added_packages() {
  local run_id="$1" base since
  base="$STATE_DIR/baseline/$run_id-pacman-Qq.txt"
  if [ -f "$base" ] && have pacman; then
    comm -13 <(sort "$base") <(pacman -Qq | sort)
    return 0
  fi
  have pacman || return 1
  [ -r /var/log/pacman.log ] || return 1
  since="${run_id:0:4}-${run_id:4:2}-${run_id:6:2}T${run_id:9:2}:${run_id:11:2}:${run_id:13:2}"
  awk -v since="$since" '
    /^\[[0-9][0-9][0-9][0-9]-/ { ts = substr($0, 2, 19) }
    /\[ALPM\] installed / && ts >= since {
      line = $0
      sub(/.*\[ALPM\] installed /, "", line)
      sub(/ .*/, "", line)
      print line
    }
  ' /var/log/pacman.log | sort -u
}

# 账本之外、安装器留下的东西（kosctl / kwriteconfig6 / sudo cp 写的，没走记账助手）
extra_dirs() {
  printf '%s\n' \
    "$HOME/.cache/kos-src" \
    "$HOME/.cache/kos-installer" \
    "$HOME/.local/share/kos" \
    "$HOME/.local/share/wallpapers" \
    "$HOME/.local/share/plasma/shells/org.kos.desktop" \
    "$HOME/.local/share/plasma/look-and-feel/org.kos.desktop" \
    "$HOME/.config/quickshell" \
    "$HOME/.local/state/quickshell" \
    "$HOME/.local/state/b23" \
    "$HOME/scripts" \
    "/etc/sddm/themes/silent" \
    "/boot/grub/themes/$GRUB_THEME_NAME"
}

extra_files() {
  local user; user=$(id -un)
  printf '%s\n' \
    "$HOME/.face" \
    "$HOME/.face.icon" \
    "$HOME/.config/plasmashellrc" \
    "$HOME/.config/kwinrulesrc" \
    "$HOME/.config/dolphinrc" \
    "$HOME/.config/kscreenlockerrc" \
    "$HOME/.config/plasma-localerc" \
    "$HOME/.config/plasma-org.kos.desktop-appletsrc" \
    "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" \
    "/usr/share/sddm/faces/$user.face.icon" \
    "/var/lib/AccountsService/icons/$user"
  # KOS 的用户级 unit（kosctl 装的，没进账本）
  local u
  for u in "$HOME"/.config/systemd/user/kos-*.service "$HOME"/.config/systemd/user/kos-*.timer; do
    [ -e "$u" ] && printf '%s\n' "$u"
  done
}

# 仓库检出：只有干净、且没有未推送提交时才默认删
repo_is_safe() {
  local dir="$1"
  [ -d "$dir/.git" ] || return 1
  have git || return 1
  [ -z "$(git -C "$dir" status --porcelain 2>/dev/null)" ] || return 1
  local ahead
  ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  [ "${ahead:-0}" -eq 0 ] || return 1
  return 0
}

main() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run|-n) DRY_RUN=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      --with-repo) REPO_MODE=yes ;;
      --keep-repo) REPO_MODE=no ;;
      -h|--help) usage; return 0 ;;
      *) warn "不认识的参数：$arg"; usage; return 2 ;;
    esac
  done

  local dir="" run_id="" manifest=""
  if dir=$(resolve_run); then
    run_id=$(basename "$dir")
    manifest="$dir/manifest.txt"
  else
    warn "没找到安装账本（$BACKUP_ROOT），只能按已知路径清理，包差集也退回到 pacman.log"
  fi

  local -a added=() restore_src=() restore_bak=() del_files=() del_dirs=()
  local line src bak p

  if [ -n "$run_id" ]; then
    while IFS= read -r p; do [ -n "$p" ] && added+=("$p"); done < <(added_packages "$run_id" 2>/dev/null || true)
  fi

  while IFS= read -r p; do [ -n "$p" ] && del_dirs+=("$p"); done < <(extra_dirs)
  while IFS= read -r p; do [ -n "$p" ] && del_files+=("$p"); done < <(extra_files)

  if [ -d "$BACKUP_ROOT" ]; then
    # 账本可能有好几份（每次装/重跑一份）。这里取并集：
    #   还原项 = 每个文件"最早一次被备份"的那份（= 装之前的样子）
    #   删除项 = 任何一份账本里出现过的 created
    local -A seen_restore=() seen_created=()
    local d m
    while IFS= read -r d; do
      m="$d/manifest.txt"
      [ -s "$m" ] || continue
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
          "created "*)
            p="${line#created }"
            [ -n "${seen_created[$p]:-}" ] && continue
            # 早先被当成"已存在"记过备份的，说明它装之前就有 → 不删
            [ -n "${seen_restore[$p]:-}" ] && continue
            seen_created[$p]=1
            del_files+=("$p")
            ;;
          *)
            read -r src _ bak <<< "$line"
            if [ -z "${bak:-}" ]; then warn "账本行看不懂，跳过：$line"; continue; fi
            [ -n "${seen_restore[$src]:-}" ] && continue
            # 最早一次提到它就是"安装器新建"的 → 它本来就是我们的文件，删掉而不是还原
            [ -n "${seen_created[$src]:-}" ] && continue
            seen_restore[$src]=1
            restore_src+=("$src"); restore_bak+=("$bak")
            ;;
        esac
      done < "$m"
    done < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort)
  fi

  # 如果连桌面（plasma-desktop / kwin）都在卸载名单里，那 KDE 的配置文件也没必要留：
  # 它们只可能来自这次安装。统一划进删除集，避免"桌面没了但 ~/.config 还留一堆"。
  local desktop_removed=0
  for p in "${added[@]:-}"; do
    case "$p" in plasma-desktop|kwin|plasma-workspace) desktop_removed=1 ;; esac
  done
  if [ "$desktop_removed" -eq 1 ]; then
    del_files+=(
      "$HOME/.config/kdeglobals" "$HOME/.config/kwinrc" "$HOME/.config/kglobalshortcutsrc"
      "$HOME/.config/kcminputrc" "$HOME/.config/kwinrulesrc" "$HOME/.config/dolphinrc"
      "$HOME/.config/mimeapps.list" "$HOME/.config/plasmashellrc" "$HOME/.config/kscreenlockerrc"
      "$HOME/.config/plasma-localerc" "$HOME/.config/plasma-org.kos.desktop-appletsrc"
      "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
    )
  fi

  # 目录已经整删的，不再逐个删文件；还原过的文件不再删
  local -a del_keep=()
  for p in "${del_files[@]:-}"; do
    [ -n "$p" ] || continue
    case " ${del_dirs[*]:-} " in *" $p "*) continue ;; esac
    local skip=0 i
    for i in "${!restore_src[@]}"; do
      [ "${restore_src[$i]:-}" = "$p" ] && { skip=1; break; }
    done
    [ "$skip" -eq 1 ] || del_keep+=("$p")
  done
  del_files=("${del_keep[@]:-}")

  # 还原项过滤：要整删的目录里的文件不用还原；删除集里的文件删除优先
  local -a rs_final=() rb_final=()
  local k in_deleted_dir
  for k in "${!restore_src[@]}"; do
    p="${restore_src[$k]}"
    in_deleted_dir=0
    local dd
    for dd in "${del_dirs[@]:-}"; do
      [ -n "$dd" ] || continue
      case "$p" in "$dd"/*) in_deleted_dir=1; break ;; esac
    done
    [ "$in_deleted_dir" -eq 1 ] && continue
    local skip2=0 f
    for f in "${del_files[@]:-}"; do
      [ "${f:-}" = "$p" ] && { skip2=1; break; }
    done
    [ "$skip2" -eq 1 ] && continue
    rs_final+=("$p"); rb_final+=("${restore_bak[$k]}")
  done
  restore_src=("${rs_final[@]:-}")
  restore_bak=("${rb_final[@]:-}")

  local -a existing_dirs=() existing_files=()
  for p in "${del_dirs[@]:-}"; do [ -n "$p" ] && [ -e "$p" ] && existing_dirs+=("$p"); done
  for p in "${del_files[@]:-}"; do [ -n "$p" ] && [ -e "$p" ] && existing_files+=("$p"); done

  # 仓库
  REPO_DIR=$(detect_repo)
  local del_repo=0
  case "$REPO_MODE" in
    yes) del_repo=1 ;;
    no) del_repo=0 ;;
    auto)
      if [ -n "$REPO_DIR" ] && repo_is_safe "$REPO_DIR"; then del_repo=1; else del_repo=0; fi
      ;;
  esac

  say "== 回到装 KOS 之前 =="
  if [ -n "$run_id" ]; then
    say "账本：$run_id（$(fmt_run "$run_id")）"
  else
    say "账本：无"
  fi
  say ""
  say "1) 卸载 ${#added[@]} 个安装期间新增的软件包"
  local n=0
  for p in "${added[@]:-}"; do
    [ -n "$p" ] || continue
    n=$((n + 1)); [ "$n" -le 6 ] && say2 "$p"
  done
  [ "$n" -gt 6 ] && say2 "…（共 $n 个）"
  [ "$n" -eq 0 ] && say2 "（没有）"
  say ""
  say "2) 还原 ${#restore_src[@]} 个被覆盖的文件，删除 ${#existing_files[@]} 个新建文件"
  for p in "${restore_src[@]:-}"; do [ -n "$p" ] && say2 "还原 $p"; done
  for p in "${existing_files[@]:-}"; do say2 "删除 $p"; done
  say ""
  say "3) 删除 ${#existing_dirs[@]} 个安装器留下的目录"
  for p in "${existing_dirs[@]:-}"; do
    say2 "$p  ($(du -sh "$p" 2>/dev/null | cut -f1))"
  done
  say ""
  say "4) 删除安装器自己的状态目录（含账本与备份）"
  for p in "$STATE_DIR" "$HOME/.cache/kos-installer"; do
    [ -e "$p" ] && say2 "$p"
  done
  if [ "$del_repo" -eq 1 ]; then
    say ""
    say "5) 删除安装器仓库检出：$REPO_DIR"
  elif [ -n "$REPO_DIR" ] && [ -e "$REPO_DIR" ]; then
    say ""
    say "5) 保留仓库检出：$REPO_DIR（有本地改动/未推送提交，或用了 --keep-repo）"
  fi
  say ""
  say "注意：跑完这个桌面就被卸掉了，请在 TTY 里跑；之后重启一次就是干净起点。"

  if [ "$DRY_RUN" -eq 1 ]; then
    say ""
    say "[dry-run] 只打印计划，什么都没动。"
    return 0
  fi

  if [ "$ASSUME_YES" -ne 1 ]; then
    printf '确认清空？输入 yes 继续：'
    read -r arg
    case "$arg" in
      y|Y|yes|YES) ;;
      *) say "已取消，什么都没改。"; return 1 ;;
    esac
  fi

  local failed=0

  if [ "${#added[@]}" -gt 0 ]; then
    say ""
    say "卸载软件包…"
    if ! sudo pacman -Rns --noconfirm "${added[@]}"; then
      warn "卸载没有全部成功（依赖冲突之类），剩下的看上面 pacman 输出"
      failed=1
    fi
  fi

  say ""
  say "还原文件…"
  local i
  for i in "${!restore_src[@]}"; do
    [ -n "${restore_src[$i]:-}" ] || continue
    if [ ! -f "${restore_bak[$i]}" ]; then
      warn "备份丢了，跳过：${restore_src[$i]}"; failed=1; continue
    fi
    if needs_root "${restore_src[$i]}"; then
      sudo cp -a "${restore_bak[$i]}" "${restore_src[$i]}" || { warn "还原失败：${restore_src[$i]}"; failed=1; }
    else
      cp -a "${restore_bak[$i]}" "${restore_src[$i]}" || { warn "还原失败：${restore_src[$i]}"; failed=1; }
    fi
  done

  say "删除文件…"
  for p in "${del_files[@]:-}"; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || continue
    if needs_root "$p"; then
      sudo rm -f -- "$p" || { warn "删除失败：$p"; failed=1; }
    else
      rm -f -- "$p" || { warn "删除失败：$p"; failed=1; }
    fi
  done

  say "删除目录…"
  for p in "${del_dirs[@]:-}"; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || continue
    if needs_root "$p"; then
      sudo rm -rf -- "$p" || { warn "删除失败：$p"; failed=1; }
    else
      rm -rf -- "$p" || { warn "删除失败：$p"; failed=1; }
    fi
  done

  # ~/bin 里指向 ~/scripts 的软链（~/scripts 已删）
  if [ -d "$HOME/bin" ]; then
    local link
    for link in "$HOME"/bin/*; do
      [ -L "$link" ] || continue
      case "$(readlink "$link" 2>/dev/null || true)" in
        "$HOME/scripts/"*) rm -f -- "$link" ;;
      esac
    done
    rmdir "$HOME/bin" 2>/dev/null || true
  fi

  # AccountsService 里的头像行
  if [ -f "/var/lib/AccountsService/users/$(id -un)" ]; then
    sudo sed -i '/^Icon=\/var\/lib\/AccountsService\/icons\//d' "/var/lib/AccountsService/users/$(id -un)" 2>/dev/null || true
  fi

  # 安装器把默认 target 改成了 graphical.target；桌面卸掉后回多用户，免得开机卡在
  # "graphical target 但没有显示管理器"的状态。
  sudo systemctl set-default multi-user.target >/dev/null 2>&1 || true
  sudo systemctl daemon-reload 2>/dev/null || true

  if [ "$del_repo" -eq 1 ] && [ -d "$REPO_DIR" ]; then
    say "删除仓库检出：$REPO_DIR"
    rm -rf -- "$REPO_DIR" || { warn "删除失败：$REPO_DIR"; failed=1; }
  fi

  # 账本最后删：前面任何一步失败都还能再跑一次
  if [ "$failed" -eq 0 ]; then
    say "删除安装器状态目录…"
    rm -rf -- "$STATE_DIR" 2>/dev/null || warn "删除失败：$STATE_DIR"
    rm -rf -- "$HOME/.cache/kos-installer" 2>/dev/null || true
  else
    warn "有步骤失败，保留账本（$STATE_DIR）方便再跑一次 kos-undo"
  fi

  say ""
  if [ "$failed" -eq 0 ]; then
    say "已清空。重启一次，就是 archinstall 刚装完的样子。"
    return 0
  fi
  warn "有步骤没成功，见上面的输出；修好后再跑一次 kos-undo"
  return 1
}

main "$@"
