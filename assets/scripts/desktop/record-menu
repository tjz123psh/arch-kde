#!/usr/bin/env bash
# KOS 录屏菜单（fuzzel 菜单 + gpu-screen-recorder 后端）
#
# 为什么不是 wf-recorder / wl-screenrec：KWin 不实现 wlr-screencopy，那些工具抓不到屏。
# gpu-screen-recorder 走 KMS + GPU 编码，KDE Wayland 下最省资源，也是这里唯一的后端。
set -u

export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

OUTDIR_DEFAULT="$HOME/Videos/Recordings"
CONFIG_DIR="$HOME/.config/kos-record"
CONFIG_FILE="$CONFIG_DIR/config"
RUNTIME_DIR="$(printenv XDG_RUNTIME_DIR 2>/dev/null)"
[ -n "$RUNTIME_DIR" ] || RUNTIME_DIR="/tmp"
RUN="$RUNTIME_DIR/kos-record"
SOCK="$RUN/gsr.sock"
PIDFILE="$RUN/pid"
MODEFILE="$RUN/mode"
SRCFILE="$RUN/src"
LOGFILE="$RUN/log"
mkdir -p "$CONFIG_DIR" "$RUN"

# ---- 持久化设置（~/.config/kos-record/config）----
FPS=60
CODEC=auto
ENCODER=gpu
AUDIO=output
AUDIO_DEV=""
CONTAINER=mp4
REPLAY_SECS=30
ANIM_FORMAT=gif
ANIM_FPS=15
ANIM_WIDTH=640
ANIM_MAX_MB=12
OUTDIR="$OUTDIR_DEFAULT"

load_config() {
  [ -f "$CONFIG_FILE" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in
      FPS) FPS="$v" ;;
      CODEC) CODEC="$v" ;;
      ENCODER) ENCODER="$v" ;;
      AUDIO) AUDIO="$v" ;;
      AUDIO_DEV) AUDIO_DEV="$v" ;;
      CONTAINER) CONTAINER="$v" ;;
      REPLAY_SECS) REPLAY_SECS="$v" ;;
      ANIM_FORMAT) ANIM_FORMAT="$v" ;;
      ANIM_FPS) ANIM_FPS="$v" ;;
      ANIM_WIDTH) ANIM_WIDTH="$v" ;;
      ANIM_MAX_MB) ANIM_MAX_MB="$v" ;;
      OUTDIR) [ -n "$v" ] && OUTDIR="$v" ;;
    esac
  done < "$CONFIG_FILE"
}

save_config() {
  {
    printf 'FPS=%s\n' "$FPS"
    printf 'CODEC=%s\n' "$CODEC"
    printf 'ENCODER=%s\n' "$ENCODER"
    printf 'AUDIO=%s\n' "$AUDIO"
    printf 'AUDIO_DEV=%s\n' "$AUDIO_DEV"
    printf 'CONTAINER=%s\n' "$CONTAINER"
    printf 'REPLAY_SECS=%s\n' "$REPLAY_SECS"
    printf 'ANIM_FORMAT=%s\n' "$ANIM_FORMAT"
    printf 'ANIM_FPS=%s\n' "$ANIM_FPS"
    printf 'ANIM_WIDTH=%s\n' "$ANIM_WIDTH"
    printf 'ANIM_MAX_MB=%s\n' "$ANIM_MAX_MB"
    printf 'OUTDIR=%s\n' "$OUTDIR"
  } > "$CONFIG_FILE"
}

load_config
mkdir -p "$OUTDIR"

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a 录屏 "$@" >/dev/null 2>&1 || true
}

running() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null || true)
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

mode() { cat "$MODEFILE" 2>/dev/null || true; }
have_gsr() { command -v gpu-screen-recorder >/dev/null 2>&1; }

audio_label() {
  if [ -n "$AUDIO_DEV" ]; then echo "$AUDIO_DEV"; return; fi
  case "$AUDIO" in
    output) echo 系统声音 ;;
    both) echo 系统声音+麦克风 ;;
    mic) echo 麦克风 ;;
    none) echo 静音 ;;
    *) echo "$AUDIO" ;;
  esac
}

codec_label() {
  case "$CODEC" in
    auto) echo 自动 ;;
    h264) echo H.264 ;;
    hevc) echo HEVC ;;
    av1) echo AV1 ;;
    *) echo "$CODEC" ;;
  esac
}

start_record() {
  local target="$1" kind="$2" out
  if running; then notify "已经在录制了" "先停止再开新的"; return 0; fi
  if ! have_gsr; then notify "缺少 gpu-screen-recorder" "sudo pacman -S gpu-screen-recorder"; return 1; fi
  if [ "$kind" = anim ]; then
    out="$OUTDIR/anim-src-$(date +%H%M%S).mp4"
  else
    out="$OUTDIR/$(date +%Y%m%d-%H%M%S).$CONTAINER"
  fi
  rm -f "$SOCK"
  set -- -w "$target" -f "$FPS" -c "$CONTAINER"
  case "$CODEC" in
    auto) ;;
    *) set -- "$@" -k "$CODEC" ;;
  esac
  case "$ENCODER" in
    cpu) set -- "$@" -encoder cpu ;;
  esac
  if [ -n "$AUDIO_DEV" ]; then
    set -- "$@" -a "$AUDIO_DEV"
  else
    case "$AUDIO" in
      output) set -- "$@" -a default_output ;;
      both) set -- "$@" -a 'default_output|default_input' ;;
      mic) set -- "$@" -a default_input ;;
    esac
  fi
  gpu-screen-recorder "$@" -o "$out" -ipc "$SOCK" >"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  echo "$kind" > "$MODEFILE"
  echo "$out" > "$SRCFILE"
  sleep 1.2
  if running; then
    notify "开始录制 · $FPS fps · $(codec_label) · $(audio_label)" "$(basename "$out")"
  else
    notify "录制启动失败" "$(tail -2 "$LOGFILE" 2>/dev/null | tr '\n' ' ')"
    rm -f "$PIDFILE"
  fi
}

start_replay() {
  if running; then notify "已经在录制了" "先停止再开新的"; return 0; fi
  if ! have_gsr; then notify "缺少 gpu-screen-recorder" "sudo pacman -S gpu-screen-recorder"; return 1; fi
  rm -f "$SOCK"
  set -- -w screen -f "$FPS" -c "$CONTAINER"
  case "$CODEC" in
    auto) ;;
    *) set -- "$@" -k "$CODEC" ;;
  esac
  if [ -n "$AUDIO_DEV" ]; then
    set -- "$@" -a "$AUDIO_DEV"
  else
    case "$AUDIO" in
      output) set -- "$@" -a default_output ;;
      both) set -- "$@" -a 'default_output|default_input' ;;
      mic) set -- "$@" -a default_input ;;
    esac
  fi
  gpu-screen-recorder "$@" -r "$REPLAY_SECS" -o "$OUTDIR" -ipc "$SOCK" >"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  echo replay > "$MODEFILE"
  sleep 1.2
  if running; then
    notify "回放缓冲已开启" "保留最近 $REPLAY_SECS 秒，随时可以保存"
  else
    notify "回放启动失败" "$(tail -2 "$LOGFILE" 2>/dev/null | tr '\n' ' ')"
    rm -f "$PIDFILE"
  fi
}

convert_anim() {
  local src="$1" base out colors w attempt size mb final
  if ! command -v ffmpeg >/dev/null 2>&1; then
    notify "缺少 ffmpeg" "无法把录制转成动图"
    return 1
  fi
  [ -f "$src" ] || return 1
  base=$(printf '%s' "$src" | sed 's/\.mp4$//')
  out="$base.$ANIM_FORMAT"
  colors=256
  w="$ANIM_WIDTH"
  mb="$ANIM_MAX_MB"
  attempt=0
  while [ "$attempt" -lt 3 ]; do
    if [ "$ANIM_FORMAT" = webp ]; then
      ffmpeg -y -loglevel error -i "$src" -vf "fps=$ANIM_FPS,scale=$w:-1:flags=lanczos" -c:v libwebp -lossless 0 -q:v 80 -loop 0 "$out" || return 1
    else
      ffmpeg -y -loglevel error -i "$src" -vf "fps=$ANIM_FPS,scale=$w:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=$colors:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4" "$out" || return 1
    fi
    size=$(stat -c %s "$out" 2>/dev/null || echo 0)
    if [ "$mb" -le 0 ] || [ $((size / 1024 / 1024)) -le "$mb" ]; then break; fi
    attempt=$((attempt + 1))
    if [ "$colors" -gt 128 ]; then
      colors=128
    elif [ "$w" -gt 480 ]; then
      w=$((w * 3 / 4))
    else
      break
    fi
  done
  final="$OUTDIR/$(date +%Y%m%d-%H%M%S).$ANIM_FORMAT"
  mv -f "$out" "$final" 2>/dev/null || final="$out"
  rm -f "$src"
  notify "动图已生成（$ANIM_FORMAT）" "$(basename "$final")"
}

stop_current() {
  local m pid reply src
  if ! running; then notify "当前没有在录制"; return 0; fi
  m=$(mode)
  pid=$(cat "$PIDFILE" 2>/dev/null || true)
  src=$(cat "$SRCFILE" 2>/dev/null || true)
  case "$m" in
    replay)
      gsr-cli -ipc "$SOCK" stop >/dev/null 2>&1 || kill -INT "$pid" 2>/dev/null
      notify "回放缓冲已关闭" ;;
    anim)
      gsr-cli -ipc "$SOCK" stop >/dev/null 2>&1 || kill -INT "$pid" 2>/dev/null
      sleep 1
      notify "正在转成动图…" "$ANIM_FORMAT · $ANIM_FPS fps · $ANIM_WIDTH px"
      convert_anim "$src" ;;
    *)
      reply=$(gsr-cli -ipc "$SOCK" stop 2>/dev/null || kill -INT "$pid" 2>/dev/null)
      notify "录制已保存" "$reply" ;;
  esac
  sleep 0.5
  rm -f "$PIDFILE" "$MODEFILE" "$SRCFILE"
}

toggle_pause() {
  local out
  if ! running; then notify "当前没有在录制"; return 0; fi
  out=$(gsr-cli -ipc "$SOCK" toggle-pause 2>&1 || true)
  notify "暂停 / 继续" "$out"
}

save_replay() {
  local path
  if ! running || [ "$(mode)" != replay ]; then
    notify "回放缓冲没在运行" "先在菜单里选「开启回放缓冲」"
    return 0
  fi
  path=$(gsr-cli -ipc "$SOCK" save-replay "$REPLAY_SECS" 2>/dev/null || true)
  notify "已保存最近 $REPLAY_SECS 秒" "$path"
}

status_line() {
  if running; then
    echo "正在运行：$(mode)（pid $(cat "$PIDFILE" 2>/dev/null)）"
  else
    echo "空闲"
  fi
}

status_json() {
  local state text
  if running; then
    state=$(mode)
    text="录制中：$state"
  else
    state=idle
    text="空闲"
  fi
  printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$text" "$state" "保存目录：$OUTDIR"
}

pick() { fuzzel --dmenu --prompt=' 录屏 > ' --lines=14 --width=54 --placeholder="$1"; }

pick_audio_device() {
  local choice dev
  choice=$( { echo "跟随默认（用上面那一档）"; gpu-screen-recorder --list-audio-devices 2>/dev/null; } | pick "选择音频设备") || return 0
  case "$choice" in
    "") return 0 ;;
    跟随默认*) AUDIO_DEV="" ;;
    *) dev=$(printf '%s' "$choice" | cut -d'|' -f1); AUDIO_DEV="$dev" ;;
  esac
  save_config
}

settings_menu() {
  local i_fps i_codec i_enc i_audio i_dev i_cont i_replay i_dir i_afmt i_afps i_aw i_amb choice v
  while :; do
    i_fps="帧率：$FPS fps"
    i_codec="编码：$(codec_label)"
    i_enc="编码器：$ENCODER"
    i_audio="音频：$(audio_label)"
    i_dev="音频设备：$(if [ -n "$AUDIO_DEV" ]; then echo "$AUDIO_DEV"; else echo 跟随默认; fi)"
    i_cont="容器：$CONTAINER"
    i_replay="回放缓冲：$REPLAY_SECS 秒"
    i_dir="保存目录：$OUTDIR"
    i_afmt="动图格式：$ANIM_FORMAT"
    i_afps="动图帧率：$ANIM_FPS fps"
    i_aw="动图宽度：$ANIM_WIDTH px"
    i_amb="动图体积上限：$ANIM_MAX_MB MB"
    choice=$(printf '%s\n' "$i_fps" "$i_codec" "$i_enc" "$i_audio" "$i_dev" "$i_cont" "$i_replay" "$i_dir" "$i_afmt" "$i_afps" "$i_aw" "$i_amb" "返回" | pick "选择录屏设置") || return 0
    case "$choice" in
      帧率：*)
        v=$(printf '%s\n' 30 60 120 144 | pick "选择帧率") || continue
        if [ -n "$v" ]; then FPS="$v"; save_config; fi ;;
      编码：*)
        v=$(printf '%s\n' 自动 H.264 HEVC AV1 | pick "选择编码") || continue
        case "$v" in
          自动) CODEC=auto ;; H.264) CODEC=h264 ;; HEVC) CODEC=hevc ;; AV1) CODEC=av1 ;;
        esac
        save_config ;;
      编码器：*)
        v=$(printf '%s\n' gpu cpu | pick "选择编码器") || continue
        if [ -n "$v" ]; then ENCODER="$v"; save_config; fi ;;
      音频：*)
        v=$(printf '%s\n' 系统声音 系统声音+麦克风 麦克风 静音 | pick "选择音频来源") || continue
        case "$v" in
          系统声音) AUDIO=output; AUDIO_DEV="" ;;
          系统声音+麦克风) AUDIO=both; AUDIO_DEV="" ;;
          麦克风) AUDIO=mic; AUDIO_DEV="" ;;
          静音) AUDIO=none; AUDIO_DEV="" ;;
        esac
        save_config ;;
      音频设备：*) pick_audio_device ;;
      容器：*)
        v=$(printf '%s\n' mp4 mkv webm | pick "选择容器") || continue
        if [ -n "$v" ]; then CONTAINER="$v"; save_config; fi ;;
      回放缓冲：*)
        v=$(printf '%s\n' 30 60 120 300 | pick "回放缓冲长度（秒）") || continue
        if [ -n "$v" ]; then REPLAY_SECS="$v"; save_config; fi ;;
      保存目录：*)
        v=$(printf '%s\n' "$HOME/Videos/Recordings" "$HOME/Videos" "$HOME" | pick "选择保存目录") || continue
        if [ -n "$v" ]; then OUTDIR="$v"; mkdir -p "$OUTDIR"; save_config; fi ;;
      动图格式：*)
        v=$(printf '%s\n' gif webp | pick "选择动图格式（webp 体积更小）") || continue
        if [ -n "$v" ]; then ANIM_FORMAT="$v"; save_config; fi ;;
      动图帧率：*)
        v=$(printf '%s\n' 10 12.5 15 20 25 | pick "选择动图帧率") || continue
        if [ -n "$v" ]; then ANIM_FPS="$v"; save_config; fi ;;
      动图宽度：*)
        v=$(printf '%s\n' 480 640 800 960 1280 | pick "选择动图宽度（px）") || continue
        if [ -n "$v" ]; then ANIM_WIDTH="$v"; save_config; fi ;;
      动图体积上限：*)
        v=$(printf '%s\n' 5 8 12 20 0 | pick "体积上限（MB，0 = 不限）") || continue
        if [ -n "$v" ]; then ANIM_MAX_MB="$v"; save_config; fi ;;
      返回|"") return 0 ;;
    esac
  done
}

run_choice() {
  case "$1" in
    开始录制*)         start_record screen record ;;
    选择屏幕*)         start_record portal record ;;
    录制动图*)         start_record screen anim ;;
    开启回放缓冲*)      start_replay ;;
    暂停*)             toggle_pause ;;
    保存最近*)         save_replay ;;
    停止回放缓冲*)      stop_current ;;
    停止录制*)         stop_current ;;
    停止并转成动图*)    stop_current ;;
    设置*)             settings_menu ;;
    打开录制目录*)      xdg-open "$OUTDIR" >/dev/null 2>&1 & ;;
    查看最近日志*)      notify "最近日志" "$(tail -3 "$LOGFILE" 2>/dev/null | tr '\n' ' ')" ;;
    *)                 notify "没认出来这个选项" "$1" ;;
  esac
}

arg=""
[ $# -gt 0 ] && arg="$1"
case "$arg" in
  --status) status_line; exit 0 ;;
  --status-json) status_json; exit 0 ;;
  --settings) settings_menu; exit 0 ;;
  --start) start_record screen record; exit 0 ;;
  --stop) stop_current; exit 0 ;;
  --toggle)
    if running; then stop_current; else start_record screen record; fi
    exit 0 ;;
  --do)
    shift
    run_choice "$1"
    exit 0 ;;
esac

if ! command -v fuzzel >/dev/null 2>&1; then
  notify "缺少 fuzzel" "无法显示录屏菜单"
  exit 1
fi

if running; then
  case "$(mode)" in
    replay)
      options="保存最近 $REPLAY_SECS 秒
停止回放缓冲
打开录制目录
查看最近日志" ;;
    anim)
      options="停止并转成动图
打开录制目录
查看最近日志" ;;
    *)
      options="暂停 / 继续
停止录制
打开录制目录
查看最近日志" ;;
  esac
else
  options="开始录制（全屏 · $FPS fps · $(codec_label) · $(audio_label)）
选择屏幕/窗口录制（系统弹窗）
录制动图（$ANIM_FORMAT · $ANIM_FPS fps · $ANIM_WIDTH px）
开启回放缓冲（最近 $REPLAY_SECS 秒）
设置…
打开录制目录
查看最近日志"
fi

choice=$(printf '%s\n' "$options" | pick "选择录屏动作") || exit 0
[ -n "$choice" ] || exit 0
run_choice "$choice"
