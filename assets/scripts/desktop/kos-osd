#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# KOS feedback helper: change volume/brightness, then ask the shell OSD to show
# the result. Never let a failed OSD call block the actual device change.

set -u

action="${1:-}"
sink="${KOS_AUDIO_SINK:-@DEFAULT_AUDIO_SINK@}"

notify() {
  local kind="$1" value="$2" muted="${3:-0}"
  command -v qs >/dev/null 2>&1 || return 0
  if [ "$kind" = "brightness" ]; then
    qs ipc -c kos call osd brightness "$value" >/dev/null 2>&1 || true
  else
    qs ipc -c kos call osd volume "$value" "$muted" >/dev/null 2>&1 || true
  fi
}

audio_state() {
  local out vol pct muted
  out="$(wpctl get-volume "$sink" 2>/dev/null)" || return 1
  vol="$(printf '%s' "$out" | awk '{print $2}')"
  [[ -n "$vol" ]] || return 1
  muted=0
  [[ "$out" == *MUTED* ]] && muted=1
  pct="$(awk -v v="$vol" 'BEGIN { printf "%d", (v * 100) + 0.5 }')"
  printf '%s %s\n' "$pct" "$muted"
}

show_audio() {
  local state pct muted
  state="$(audio_state)" || { notify volume 0 1; return 0; }
  read -r pct muted <<<"$state"
  notify volume "$pct" "$muted"
}

volume_up() {
  wpctl set-mute "$sink" 0 >/dev/null 2>&1 || true
  wpctl set-volume "$sink" 5%+ >/dev/null 2>&1 || true
  show_audio
}

volume_down() {
  wpctl set-volume "$sink" 5%- >/dev/null 2>&1 || true
  show_audio
}

volume_mute() {
  wpctl set-mute "$sink" toggle >/dev/null 2>&1 || true
  show_audio
}

brightness_state() {
  local line pct
  line="$(brightnessctl -m 2>/dev/null | head -n 1)" || return 1
  pct="$(printf '%s' "$line" | awk -F, '{gsub(/%/, "", $4); print $4}')"
  [[ -n "$pct" ]] || return 1
  printf '%s\n' "$pct"
}

brightness_set() {
  local delta="$1" cur next
  cur="$(brightness_state)" || return 1
  next=$(( cur + delta ))
  (( next < 1 )) && next=1
  (( next > 100 )) && next=100
  brightnessctl set "${next}%" >/dev/null 2>&1 || return 1
  notify brightness "$next" 0
}

case "$action" in
  volume-up)      volume_up ;;
  volume-down)    volume_down ;;
  volume-mute)    volume_mute ;;
  brightness-up)  brightness_set 5 ;;
  brightness-down) brightness_set -5 ;;
  *)
    printf 'usage: %s volume-up|volume-down|volume-mute|brightness-up|brightness-down\n' "$0" >&2
    exit 2
    ;;
esac
