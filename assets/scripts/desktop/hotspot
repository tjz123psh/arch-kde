#!/usr/bin/env bash
# KOS 热点菜单（fuzzel）：用 NetworkManager 的 shared 模式 + dnsmasq 共享有线网络。
#
# 依赖：NetworkManager（在跑）、dnsmasq（shared 模式的 DHCP/DNS，缺了会报 "IP 配置无法保留"）、
#       qrencode（可选，用来看二维码）、fuzzel（菜单）。
set -u

export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

CON="KOS-Hotspot"
DEFAULT_SSID="KOS-Hotspot"
QR_PNG="/tmp/kos-hotspot-qr.png"

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a 热点 "$@" >/dev/null 2>&1 || true
}

wifi_dev() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
    awk -F: '$2 == "wifi" && $1 !~ /^p2p/ { print $1; exit }'
}

profile_exists() { nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$CON"; }
hotspot_active() { nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx "$CON"; }

prof_get() { nmcli -s -g "$1" connection show "$CON" 2>/dev/null; }

random_pw() {
  head -c 9 /dev/urandom | base64 | tr -dc 'a-z0-9' | head -c 10
}

ensure_profile() {
  local dev pw
  profile_exists && return 0
  dev=$(wifi_dev)
  if [ -z "$dev" ]; then
    notify "找不到无线网卡" "确认网卡在位且 Wi-Fi 没被硬件开关关掉"
    return 1
  fi
  pw=$(random_pw)
  nmcli connection add type wifi ifname "$dev" con-name "$CON" ssid "$DEFAULT_SSID" \
    802-11-wireless.mode ap 802-11-wireless.band bg ipv4.method shared \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pw" connection.autoconnect no >/dev/null 2>&1 || {
      notify "热点配置创建失败" "检查 NetworkManager 状态"
      return 1
    }
  notify "已创建热点配置" "SSID $DEFAULT_SSID · 密码 $pw"
}

start_hotspot() {
  local ssid ip
  if hotspot_active; then notify "热点已经在运行"; return 0; fi
  if ! command -v dnsmasq >/dev/null 2>&1; then
    notify "缺少 dnsmasq" "sudo pacman -S dnsmasq（shared 模式必须）"
    return 1
  fi
  nmcli radio wifi on >/dev/null 2>&1 || true
  ensure_profile || return 1
  if nmcli connection up "$CON" >/dev/null 2>&1; then
    ssid=$(prof_get 802-11-wireless.ssid)
    ip=$(ip -4 -o addr show "$(wifi_dev)" 2>/dev/null | awk '{print $4}' | head -1)
    notify "热点已开启" "$ssid · $ip"
  else
    notify "热点开启失败" "$(journalctl -u NetworkManager --since '30 sec ago' --no-pager 2>/dev/null | grep -i dnsmasq | tail -1)"
  fi
}

stop_hotspot() {
  if ! hotspot_active; then notify "热点没有在运行"; return 0; fi
  nmcli connection down "$CON" >/dev/null 2>&1
  notify "热点已关闭"
}

status_text() {
  local dev ssid ip clients
  if ! hotspot_active; then
    echo "未开启"
    return
  fi
  dev=$(wifi_dev)
  ssid=$(prof_get 802-11-wireless.ssid)
  ip=$(ip -4 -o addr show "$dev" 2>/dev/null | awk '{print $4}' | head -1)
  clients=$(iw dev "$dev" station dump 2>/dev/null | grep -c '^Station' || true)
  echo "运行中：$ssid · $ip · 客户端 $clients 台"
}

show_info() {
  local ssid pw
  if ! profile_exists; then notify "还没有热点配置" "先选「开启热点」"; return 0; fi
  ssid=$(prof_get 802-11-wireless.ssid)
  pw=$(prof_get 802-11-wireless-security.psk)
  notify "热点信息" "$ssid · 密码 $pw"
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -o "$QR_PNG" "WIFI:T:WPA;S:$ssid;P:$pw;;" 2>/dev/null && xdg-open "$QR_PNG" >/dev/null 2>&1 &
  fi
}

set_ssid() {
  local v
  v=$(printf '' | fuzzel --dmenu --prompt=' 新热点名称 > ' --lines=0 --width=40) || return 0
  [ -n "$v" ] || return 0
  profile_exists || ensure_profile || return 1
  nmcli connection modify "$CON" 802-11-wireless.ssid "$v"
  notify "热点名称已改" "$v（重新开启热点后生效）"
}

set_password() {
  local v len
  v=$(printf '' | fuzzel --dmenu --prompt=' 新密码（至少 8 位）> ' --lines=0 --width=40) || return 0
  [ -n "$v" ] || return 0
  len=$(printf '%s' "$v" | wc -c)
  if [ "$len" -lt 8 ]; then notify "密码太短" "WPA2 至少要 8 位"; return 0; fi
  profile_exists || ensure_profile || return 1
  nmcli connection modify "$CON" wifi-sec.psk "$v"
  notify "热点密码已改" "重新开启热点后生效"
}

pick() { fuzzel --dmenu --prompt=' 热点 > ' --lines=8 --width=46 --placeholder="$1"; }

menu() {
  local st choice
  if hotspot_active; then
    st="状态：$(status_text)"
    choice=$(printf '%s\n' "关闭热点" "显示连接信息 / 二维码" "修改热点名称" "修改热点密码" "打开网络设置" | pick "$st") || return 0
  else
    choice=$(printf '%s\n' "开启热点" "显示热点信息 / 二维码" "修改热点名称" "修改热点密码" "打开网络设置" | pick "热点未开启") || return 0
  fi
  [ -n "$choice" ] || return 0
  case "$choice" in
    开启热点*)           start_hotspot ;;
    关闭热点*)           stop_hotspot ;;
    显示*)               show_info ;;
    修改热点名称*)        set_ssid ;;
    修改热点密码*)        set_password ;;
    打开网络设置*)        systemsettings kcm_networkmanagement >/dev/null 2>&1 & ;;
  esac
}

run_choice() {
  case "$1" in
    开启热点*)      start_hotspot ;;
    关闭热点*)      stop_hotspot ;;
    显示*)          show_info ;;
    修改热点名称*)   set_ssid ;;
    修改热点密码*)   set_password ;;
    状态*)          status_text ;;
    *)             notify "没认出来这个选项" "$1" ;;
  esac
}

arg=""
[ $# -gt 0 ] && arg="$1"
case "$arg" in
  --status) status_text; exit 0 ;;
  --start) start_hotspot; exit 0 ;;
  --stop) stop_hotspot; exit 0 ;;
  --toggle)
    if hotspot_active; then stop_hotspot; else start_hotspot; fi
    exit 0 ;;
  --do)
    shift
    run_choice "$1"
    exit 0 ;;
esac

if ! command -v fuzzel >/dev/null 2>&1; then
  notify "缺少 fuzzel" "无法显示热点菜单"
  exit 1
fi

menu
